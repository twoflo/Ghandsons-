# ---- Database -------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/ghandsons"

# ---- Auth -----------------------------------------------------------------
# Session lifetime in days. Sessions are random tokens stored as hashes, so
# there is no signing secret to set.
AUTH_SESSION_DAYS="30"

# ---- File storage ---------------------------------------------------------
# local | supabase
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./public/uploads"
# Only needed when STORAGE_DRIVER=supabase
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="ghandsons"

# ---- Receipt extraction ---------------------------------------------------
# OCR stage:        none | tesseract
# Extraction stage: mock | anthropic
OCR_PROVIDER="none"
EXTRACTION_PROVIDER="mock"
ANTHROPIC_API_KEY=""
EXTRACTION_MODEL="claude-opus-5"

# ---- Business defaults (overridable in Settings) --------------------------
DEFAULT_TIMEZONE="Australia/Brisbane"
